{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Clean",
            "type": "shell",
            "command": "rm",
            "args": [
                "-rf",
                "${workspaceFolder}/build",
                "${workspaceFolder}/bin",
                "${workspaceFolder}/lib",
                "${workspaceFolder}/obj"
            ]
        },
        {
            "label": "Conan Install",
            "type": "shell",
            "command": "conan",
            "args": [
                "install",
                "${workspaceFolder}",
                "--output-folder=${workspaceFolder}",
                "--build=missing",
                "-s", "build_type=Debug"
            ]
        },
        {
            "label": "Configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S", "${workspaceFolder}",
                "-B", "${workspaceFolder}/build",
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
                "-DCMAKE_TOOLCHAIN_FILE=${workspaceFolder}/build/Debug/generators/conan_toolchain.cmake"
            ],
            "dependsOn": [
                "Conan Install"
            ]
        },
        {
            "label": "Build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn":[
                "Configure"
            ],
            "problemMatcher": ["$gcc"]
        }
    ]
}